{
  "name": "yangzihao-dic-desktop",
  "version": "1.1.0",
  "private": true,
  "description": "大傻豪词典桌面版 —— 在 QQ、微信、Word 等任何程序里选词查词，存进浏览器扩展的同一个生词本",
  "license": "GPL-3.0",
  "main": "dist/main.js",
  "scripts": {
    "postinstall": "node scripts/install-electron.cjs",
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.renderer.json && node scripts/copy-static.cjs",
    "start": "npm run build && electron .",
    "package": "npm run build && node scripts/package.cjs",
    "friend-package": "node scripts/friend-package.cjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.renderer.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "koffi": "^2.16.3",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "@types/ws": "^8.18.1",
    "electron": "^44.3.0",
    "marked": "^18.0.13",
    "resedit": "^3.1.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
